bjective", "content": "secondary_8"}]}], "template_override": 1, "id": 9, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nA few employees complain about the new director. What has he done to deserve this?\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: <span class=\"bullet\">Read the sentences.</span> <span class=\"bullet\">Type in the missing words.</span><span class=\"bullet\">Choose from these phrases: <span class=\"product-color-text\">has not given</span>, <span class=\"product-color-text\">has declined</span>, <span class=\"product-color-text\">has changed</span>,<span class=\"product-color-text\"> have tried</span></span>"}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn8le14ob10re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Write a dialogue between a board member who is unhappy with a company's unethical practices and the CEO of the company."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "text": "", "id": 0}, {"time": "04000", "image": "", "text": "Hello everyone. As president of Holly's Wear, I am delighted to be updating you on the business practices of Holly's factory in Shalopolis.", "id": 1}, {"time": "16000", "image": "", "text": "Now, we were all recently made aware that Holly's factory in Shalopolis used to be affected by the practices of child labor. As things stand, I am  very proud to inform the public that we have successfully turned the situation around.", "id": 2}, {"time": "33100", "image": "", "text": "This has been very complicated. The community has lived in severe poverty for generations and has become dependent on foreign companies for employment. Understandably, the needs of large families has led to the employment of children. but of course, we acknowledge the limited prospects that result for such early labourers.", "id": 3}, {"time": "59500", "image": "", "text": "At first, Tindasians objected to our policy announcement against hiring children. Families have apparently been sending their children to work for Holly's because our factory has always used stringent safety codes. Understandably, parents have been reluctant to send children to school hungry.", "id": 4}, {"time": "82000", "image": "", "text": "We have consulted with the reputable NGO, School For All Children and we are making strategic moves to introduce corporate social responsibility as a guiding principle. We are also working to integrate social concerns into our interaction with stakeholders.", "id": 5}, {"time": "103600", "image": "", "text": "With all of this, I am very pleased to announce that Holly's is now giving long-term contracts to adult employees, and an educational stipend for their school-aged children. Finally, we are opening a new children's line of clothing called \u201cMunchkins\u201d. In fact, partial profits will go toward developing access to clean drinking water throughout Shalopolis. Updates on developments on our clothing line and in Shalopolis are available through our website. Thank you very much.", "id": 6}], "video_src": "engenn8le14ob10re2vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Presenting the Product"}, {"type": "unit_name", "content": "Right on Target"}, {"type": "position", "content": 10}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 14}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Exchange information about people's interests and backgrounds using a wider range of language."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_2", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_3", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_4", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_5", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_6", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_7", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_8", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Present Perfect "}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use the Present Perfect tense to talk about a past action or an action that began in the past that is connected to the present in some way."}, {"type": "text", "content": "You can use the <span class=\"underline\">Present Perfect tense</span>  to talk about experience. <br/>This is how you form the Present Perfect:<br/> subject + have + past participle "}, {"type": "text", "content": "When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now."}, {"type": "text", "content": "The Present Perfect is also used to emphasize the duration of a recent event. "}, {"type": "example", "content": "We have all been recently made aware of the scandal."}, {"type": "example", "content": "This has been a complicated situation for us. "}, {"type": "example", "content": "The community has become dependent on foreign aid. "}, {"type": "example", "content": "Poverty and need for employment has led to the employment of children. "}, {"type": "example", "content": "Our factory has always used strict safety codes. <br/> <br/>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Infinitive of Purpose"}, {"type": "describer", "content": " "}, {"type": "text", "content": "When expressing purpose, we normally use an infinitive of purpose (to + base form verb). It indicates the purpose or intention of an action. "}, {"type": "text", "content": "The infinitive usually answers the question \u201cWhy?\u201d We can use it after certain verbs or adjectives."}, {"type": "example", "content": "I'm <span class=\"underline\">delighted to</span>  make this announcements regarding our business practices. "}, {"type": "example", "content": "I am <span class=\"underline\">proud to</span>  inform that we are reverting the situation. "}, {"type": "example", "content": "Parents have been <span class=\"underline\">reluctant to</span>  send their children to school. "}, {"type": "example", "content": "We <span class=\"underline\">wish to</span>  integrate social responsibility into our new practices. "}, {"type": "example", "content": "We've been <span class=\"underline\">strategizing how to</span>  introduce corporate social responsibility as our main driving force. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "child labor"}, {"type": "definition", "content": " the illegal use of children in industry"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Holly's factory in Shalopolis used to be affected by the practice of child labour."}, {"type": "audio", "content": "engenn8le14ob10aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you when providing an update on business practices. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "poverty "}, {"type": "definition", "content": "the state of being very poor"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The community has lived in severe poverty for generations and become dependent on foreign companies for employment."}, {"type": "audio", "content": "engenn8le14ob10aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "prospect "}, {"type": "definition", "content": "possibility or opportunity"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Of course, we acknowledge the limited prospects that result for such early labourers."}, {"type": "audio", "content": "engenn8le14ob10aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "policy "}, {"type": "definition", "content": " a set of rules for dealing with a particular situation"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Tindasians objected to our policy announcement against hiring children."}, {"type": "audio", "content": "engenn8le14ob10aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "stringent "}, {"type": "definition", "content": "extremely tough or severe"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Our factory has always used stringent safety codes."}, {"type": "audio", "content": "engenn8le14ob10aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "stakeholder "}, {"type": "definition", "content": "a person with an investment or an interest in a business"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We are also working to integrate social concerns into our interaction with stakeholders. "}, {"type": "audio", "content": "engenn8le14ob10aud07"}]}, {"type": "background_image", "content": "engenn8le14ob10re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a dialogue between a board member and CEO of a company."}, {"type": "text", "content": "The board member is criticizing the recent practices of the company (experiences he/she has had with the company)."}, {"type": "text", "content": "The CEO is explaining what she/he wishes to do to resolve the issues to make the company more ethical."}, {"type": "text", "content": "Read the dialogue aloud with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a dialogue."}, {"type": "text", "content": "I write about experiences I've had or haven't had."}, {"type": "text", "content": "I write about what I wish or hope to do."}, {"type": "text", "content": "I read the dialogue aloud."}]}]}
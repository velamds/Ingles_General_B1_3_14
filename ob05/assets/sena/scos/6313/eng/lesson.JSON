ent": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le14ob05re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Create a survey to rate three company's logos.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le14ob05re2img05.jpg"}, {"text": "I hope everyone enjoyed the break. We are going to continue this meeting on our rebranding strategies.\n<br></br>\nAs I was saying, the advantages of rebranding are numerous. First, it will help hide the malpractices of the past.  Second, it is going to strengthen the team and will certainly improve pride among staff.  It also addresses both internal and external issues. Furthermore, it repositions the company. In other words, it's going to be aligned with who they are and where they want to be. Finally, it will help us align with current trends in the market  \u2026  we are integrating corporate social responsibility.", "id": 1, "time": "1", "image": "engenn8le14ob05re2img05.jpg"}, {"text": "Here is an outline of our rebranding stages. </br>\nFirst, the company's mission statement is revised to reflect its new image. </br>\nSecond, the company's name is changed. </br>\nThird, the company's logo is changed or updated. A design firm is chosen and hired to create a new logo. The new logo is tested with clients, customers and staff before  an agreement is made on the final design.", "id": 2, "time": "39000", "image": "engenn8le14ob05re2img06.jpg"}, {"text": "Fourth, a marketing plan is created to introduce the new look and name of the company to customers, stakeholders, and even competitors. A calendar of events is designed to outline the main ads and promotions. </br>\nFifth, the new logo is tested out. Feedback from people involved is given so as to allow changes to be made before the final launch. </br>\nFinally, the new brand is rolled out. A public event is hosted and the new image, name and product line is presented to both current and potential customers.", "id": 3, "time": "64000", "image": "engenn8le14ob05re2img07.jpg"}], "audiosrc": "engenn8le14ob05re2aud01", "coverimg": "engenn8le14ob05re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}